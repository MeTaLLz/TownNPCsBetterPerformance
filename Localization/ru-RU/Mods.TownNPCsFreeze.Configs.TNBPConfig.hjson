DisplayName: Конфигурация TNBP

Headers: {
	FreezeMode: Заморозка
	Invincible: Неуязвимость
	Exclusions: Исключения
	Compatibility: Совместимость с модами
	Advanced: Дополнительно
}

DistantFreeze: {
	Label: "[i:3625] Дистанционная заморозка"
	Tooltip: Городские НИПы замораживаются по дистанции.
}

LoadDistanceX: {
	Label: "[i:486] Дистанция заморозки (Горизонталь)"
	Tooltip: Расстояние в тайлах (по горизонтали), на котором городские НИПы замораживаются и размораживаются.
}

LoadDistanceY: {
	Label: "[i:486] Дистанция заморозки (Вертикаль)"
	Tooltip: Расстояние в тайлах (по вертикали), на котором городские НИПы замораживаются и размораживаются.
}

BossFreeze: {
	Label: "[i:43] Заморозка во время битвы с боссом"
	Tooltip: Все городские НИПы будут заморожены во время битв с боссами.
}

MakeInvincible: {
	Label: "[i:29] Сделать неуязвимыми"
	Tooltip: Городские НИПы не получают урон.
}

ExcludedNPCs: {
	Label: "[i:267] Исключаемые городские НИПы"
	Tooltip: Эти городские НИПы никогда не будут заморожены.
}

ExcludeTravelingMerchant: {
	Label: "[i:2275] Исключить странствующего торговца"
	Tooltip: Странствующий торговец не будет заморожен, что позволит ему естественно деспавниться.
}

WrathOfTheGodsCompatibility: {
	Label: "[i:4009] Calamity: Wrath of the Gods"
	Tooltip: Солин не будет заморожена для предотвращения ее заморозки во время битв мода.
}

CalamityCompatibility: {
	Label: "[i:274] Calamity Mod"
	Tooltip: Подозрительный торговец не будет заморожен, что позволит ему естественно деспавниться.
}

TerrariaAmbienceFix: {
	Label: "[i:966] Terraria Ambience"
	Tooltip: Исправляет ошибку на выделенных серверах, где мод пытается обратиться к аудиосистемам, которых не существует.
}

FreezeInterval: {
	Label: "[i:707] Интервал обновления заморозки"
	Tooltip: Как часто (тики) мод проверяет городских НИПов на заморозку.
}

TeleportInterval: {
	Label: "[i:707] Интервал обновления телепортации"
	Tooltip: Как часто (тики) замороженные НИПы проверяют телепортацию домой.
}

SyncInterval: {
	Label: "[i:707] Интервал обновления синхронизации"
	Tooltip: Как часто (тики) замороженные НИПы синхронизируют данные дома в мультиплеере.
}

InvincibleInterval: {
	Label: "[i:707] Интервал обновления бессмертия"
	Tooltip: Как часто (тики) переприменяется статус бессмертия для городских НИПов.
}

LogToChat: {
	Label: "[i:1344] Логирование в чат"
	Tooltip: Вывод отладочной информации в чат. В мультиплеере сообщения видит только хост.
}

ModState: {
	Label: "[i:193] Состояние мода"
	Tooltip: Активирует или деактивирует всю функциональность мода.
}
