DisplayName: Конфигурация городских НИПов

Headers: {
	GhostMode: Заморозка
	Invincible: Неуязвимость
	Exclusions: Исключения
	Compatibility: Совместимость с модами
	Debug: Отладка
	Other: Прочее
}

DistantGhost: {
	Label: "[i:3625] Дистанционная заморозка"
	Tooltip: Городские НИПы замораживаются по дистанции.
}

LoadDistanceX: {
	Label: "[i:486] Дистанция заморозки (Горизонталь)"
	Tooltip: Расстояние в тайлах (по горизонтали), на котором городские НИПы замораживаются и размораживаются.
}

LoadDistanceY: {
	Label: "[i:486] Дистанция заморозки (Вертикаль)"
	Tooltip: Расстояние в тайлах (по вертикали), на котором городские НИПы замораживаются и размораживаются.
}

MakeInvincible: {
	Label: "[i:29] Сделать неуязвимыми"
	Tooltip: Городские НИПы не получают урон.
}

ExcludedNPCs: {
	Label: "[i:267] Исключаемые городские НИПы"
	Tooltip: Эти городские НИПы никогда не будут заморожены.
}

WrathOfTheGodsCompatibility: {
	Label: "[i:4009] Calamity: Wrath of the Gods"
	Tooltip: Солин не будет заморожена для предотвращения ошибок.
}

LogToChat: {
	Label: "[i:1344] Логирование в чат"
	Tooltip: Вывод отладочной информации в чат. В мультиплеере сообщения видит только хост.
}

UpdateInterval: {
	Label: "[i:707] Интервал обновления (тики)"
	Tooltip: Как часто мод проверяет состояние городских НИПов.
}

ConfigRefreshInterval: {
	Label: "[i:708] Интервал кэша конфига (тики)"
	Tooltip: Как часто мод обновляет кэшированные значения конфига.
}
